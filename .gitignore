# Ignore everything in this repository by default.
/*

# Keep only the files/directories we want to push.
!/PythonAPI/
!/howtorun.md
!/.gitignore
!/*.md

# Python cache files generated by local checks.
__pycache__/
*.py[cod]
PythonAPI/**/__pycache__/
PythonAPI/**/*.py[cod]


!/mppi_ws/
!/mppi_ws/src/
!/mppi_ws/src/dual_filter/
!/mppi_ws/src/dual_filter/**
!/mppi_ws/src/gnss_to_utm/
!/mppi_ws/src/gnss_to_utm/**

!/*.ino
!/ros2_sensor
# Keep the nav2 workspace source tree, but not local colcon build artifacts.
!/nav2_ws/
/nav2_ws/*
!/nav2_ws/src/
!/nav2_ws/src/**
/nav2_ws/build/
/nav2_ws/install/
/nav2_ws/log/

!/*.ino

!/CustomMap

# Keep the cooked custom maps (CarlaUE4/Content/map_package) but nothing else
# under CarlaUE4/. Each directory level must be un-ignored because line 2 `/*`
# excludes the top-level CarlaUE4/, and git can't re-include a path whose parent
# directory is ignored.
!/CarlaUE4/
/CarlaUE4/*
!/CarlaUE4/Content/
/CarlaUE4/Content/*
!/CarlaUE4/Content/map_package
